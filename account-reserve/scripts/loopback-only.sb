(version 1)
(allow default)
(deny network*)
(allow network-inbound (local ip "localhost:*"))
(allow network-outbound (remote ip "localhost:*"))
(allow network-bind (local ip "localhost:*"))
(allow network-bind (local unix-socket (regex #"^/private/tmp/account-reserve-store-[^/]+/redis.sock$")))
(allow network-inbound (local unix-socket (regex #"^/private/tmp/account-reserve-store-[^/]+/redis.sock$")))
(allow network-outbound (remote unix-socket (regex #"^/private/tmp/account-reserve-store-[^/]+/redis.sock$")))
